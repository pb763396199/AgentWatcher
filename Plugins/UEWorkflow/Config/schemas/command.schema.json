{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uwf.command.schema.json",
  "title": "Unreal Workflow Command Spec",
  "type": "object",
  "required": ["name", "summary", "safety", "supportsDryRun", "enabled"],
  "properties": {
    "name": { "type": "string" },
    "summary": { "type": "string" },
    "safety": { "enum": ["readOnly", "bounded", "dangerous"] },
    "supportsDryRun": { "type": "boolean" },
    "enabled": { "type": "boolean" }
  },
  "additionalProperties": false
}
