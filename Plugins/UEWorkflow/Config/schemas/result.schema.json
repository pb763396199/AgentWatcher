{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uwf.result.schema.json",
  "title": "Unreal Workflow Command Result",
  "type": "object",
  "required": ["kind", "contractVersion", "status"],
  "properties": {
    "kind": { "type": "string" },
    "contractVersion": { "type": "integer" },
    "status": { "type": "string" },
    "message": { "type": "string" },
    "module": { "type": "object" },
    "command": { "type": "string" }
  },
  "additionalProperties": true
}
