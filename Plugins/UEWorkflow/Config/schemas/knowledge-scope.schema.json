{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "uwf.knowledge-scope.schema.json",
  "title": "Unreal Workflow Knowledge Scope",
  "type": "object",
  "required": ["scopeId", "scopeKind", "displayName"],
  "properties": {
    "scopeId": { "type": "string" },
    "scopeKind": {
      "enum": ["engine_core", "engine_plugin", "project_plugin", "project", "global"]
    },
    "displayName": { "type": "string" },
    "engineVersion": { "type": "string" },
    "projectId": { "type": "string" },
    "pluginId": { "type": "string" }
  },
  "additionalProperties": true
}
