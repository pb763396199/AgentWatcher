{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentWatcher",
  "version": "0.1.0",
  "identifier": "com.agentwatcher.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../ui-dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentWatcher",
        "width": 396,
        "height": 580,
        "minWidth": 360,
        "minHeight": 460,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}